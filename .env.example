# Copy to .env and fill in. Never commit the real .env.
ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://setuhaul:setuhaul@postgres:5432/setuhaul
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# AES-GCM key for encrypting AI provider keys at rest. 32 random bytes, base64-encoded.
PROVIDER_KEY_ENCRYPTION_KEY=change-me-32-byte-base64-key====

# WhatsApp Business Platform (Cloud API) — leave blank to run against the simulator only.
# Dev-only values so the simulator can sign webhooks. Use the real app secret and verify token from Meta in production.
WHATSAPP_APP_SECRET=dev-whatsapp-app-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dev-verify-token

CORS_ORIGINS=["http://localhost:2000"]
DEFAULT_TIMEZONE=Asia/Kolkata

# Optional observability
SENTRY_DSN=
LANGSMITH_TRACING=false

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
