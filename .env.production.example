# Demo deployment on a single EC2 host. Copy to .env on the server and fill in.
# Generate secrets with:  openssl rand -hex 32   (JWT)   |   openssl rand -base64 32   (encryption key)
ENV=production
DEBUG=false

# Public hostname Caddy serves (and gets a TLS cert for). No domain? use <elastic-ip-with-dashes>.sslip.io
SITE_ADDRESS=demo.example.com
POSTGRES_PASSWORD=change-me
# DATABASE_URL / REDIS_URL are composed in docker-compose.prod.yml; values here are unused in prod.
DATABASE_URL=unused
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
PROVIDER_KEY_ENCRYPTION_KEY=change-me-base64-32-bytes

# Optional for demo: leave blank to use the built-in WhatsApp simulator.
# Webhook URL for Meta: https://<SITE_ADDRESS>/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

CORS_ORIGINS=["https://demo.example.com"]
DEFAULT_TIMEZONE=Asia/Kolkata

# Password for the demo users created by scripts.seed_demo_users
DEMO_PASSWORD=change-me

SENTRY_DSN=
LANGSMITH_TRACING=false
NEXT_PUBLIC_API_BASE_URL=https://demo.example.com
